# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Security
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key

# Transactional Email Service (Required for Forgot Password email delivery)
# Compatible with Gmail, Brevo, SendGrid, Mailgun, AWS SES, or any standard SMTP host
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_or_email
SMTP_PASS=your_smtp_app_password
FROM_EMAIL=no-reply@argusportal.com
FROM_NAME=ARGUS Portal
